# Plantilla de credenciales para SolarTech Colombia
# ─────────────────────────────────────────────────
# 1. Copia este archivo y renómbralo a: secrets.toml
# 2. Completa los valores con tus credenciales de Supabase
# 3. NUNCA subas secrets.toml a GitHub (.gitignore ya lo excluye)

DB_USER     = "tu_usuario_supabase"
DB_PASSWORD = "tu_contraseña_supabase"
DB_HOST     = "tu_host.supabase.co"
DB_PORT     = "5432"
DB_NAME     = "postgres"
